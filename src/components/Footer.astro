---
import { Image } from "astro:assets";
import logo from "../assets/runcheck-logo.svg";
import {
  ARTICLE_LOCALES,
  PUBLISHED_ARTICLE_LOCALE_CODES,
} from "../data/articleLocales.mjs";

type ArticleLocale = keyof typeof ARTICLE_LOCALES;

interface Props {
  locale?: ArticleLocale;
}

const year = new Date().getFullYear();
const { locale = "en" } = Astro.props;
const copy = ARTICLE_LOCALES[locale];
const articleLanguageNames: Record<ArticleLocale, string> = {
  en: "English",
  fi: "Suomi",
  sv: "Svenska",
  nb: "Norsk bokmål",
  de: "Deutsch",
  da: "Dansk",
  fr: "Français",
  es: "Español",
  it: "Italiano",
};
const articleLanguageLinks = PUBLISHED_ARTICLE_LOCALE_CODES.map((code) => ({
  href: ARTICLE_LOCALES[code].root,
  label: articleLanguageNames[code],
  lang: ARTICLE_LOCALES[code].lang,
}));
---

<footer class="site-footer bg-run-bg">
  <div
    class="mx-auto flex max-w-[100rem] flex-col items-center gap-7 px-5 py-12 md:grid md:grid-cols-[1fr_auto_1fr] md:gap-4"
  >
    <a
      href="/"
      class="flex items-center gap-3 md:justify-self-start"
      aria-label="runcheck home"
    >
      <Image
        src={logo}
        alt=""
        class="size-7 shrink-0 object-contain"
        loading="lazy"
      />
      <span class="text-base lowercase leading-none font-semibold text-run-text"
        >runcheck</span
      >
    </a>

    <div class="footer-navigation flex flex-col items-center gap-4">
      <nav
        class="footer-nav flex flex-col items-center gap-4 sm:flex-row sm:gap-9"
        aria-label={copy.menu[3]}
      >
        <a href="/#features">{copy.nav[0]}</a>
        <a href={copy.root}>{copy.nav[1]}</a>
        {locale === "en" && <a href="/phone-support/">Phone support</a>}
        <a href="mailto:contact@finnvek.com">{copy.nav[2]}</a>
      </nav>

      <nav
        class="footer-language-nav flex max-w-2xl flex-wrap items-center justify-center gap-x-4 gap-y-2"
        aria-label={copy.articles}
      >
        {
          articleLanguageLinks.map((link) => (
            <a href={link.href} lang={link.lang}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="footer-meta flex flex-col items-center gap-1.5 md:justify-self-end md:items-end"
    >
      <p class="footer-copyright">&copy; {year} runcheck</p>
      <a class="footer-finnvek" href="https://finnvek.com">Finnvek</a>
    </div>
  </div>
</footer>
